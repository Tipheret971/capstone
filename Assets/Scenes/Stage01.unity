  m_Script: {fileID: 11500000, guid: 46437f1ce53ac85488354139f2a9b9ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSentences:
  - "(\uC624\uB974\uD398\uC6B0\uC2A4\uB294 \uB9AC\uB77C\uB97C \uC954 \uC190\uC73C\uB85C
    \uBCBD\uC744 \uC9DA\uC73C\uBA70 \uAC77\uB294\uB2E4. \uC2DC\uAC04\uC774 \uD750\uB97C\uC218\uB85D
    \uC9C0\uCE58\uACE0 \uBD88\uC548\uD574\uC9C4\uB2E4.)"
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uC5B4\uB460\uBFD0\uC774\uAD70\u2026 \uC774
    \uACE0\uB3C5\uD558\uACE0 \uCC28\uAC00\uC6B4 \uCE68\uBB35 \uC55E\uC5D0\uC11C,
    \uB098\uB3C4 \uD3EC\uAE30\uD560\uAE4C \uB9DD\uC124\uC5EC\uC9D1\uB2C8\uB2E4."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uD558\uC9C0\uB9CC\u2026 \uB098\uB294 \uB2F9\uC2E0\uC758
    \uBAA9\uC18C\uB9AC\uB97C \uB4E3\uAE30 \uC704\uD574 \uC654\uC2B5\uB2C8\uB2E4.
    \uB0B4 \uAC00\uC2B4\uC5D0 \uC8FD\uC74C\uBCF4\uB2E4 \uAC15\uD55C \uC0AC\uB791\uC774
    \uC788\uB294 \uD55C, \uB098\uB294 \uC774 \uCE68\uBB35\uC744 \uB6AB\uACE0 \uB178\uB798\uB97C
    \uBA48\uCD94\uC9C0 \uC54A\uC744 \uAC83\uC785\uB2C8\uB2E4!"
