--- !u!114 &937625264731878675
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 247320685}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46437f1ce53ac85488354139f2a9b9ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSentences:
  - "\uC624\uB974\uD398\uC6B0\uC2A4\uB294 \uAC00\uC7A5 \uC704\uB300\uD55C \uC74C\uC720\uC2DC\uC778\uC774\uC5C8\uC2B5\uB2C8\uB2E4.
    \uADF8\uC758 \uB178\uB798\uB294 \uC2E0\uB4E4\uC870\uCC28 \uC6B8\uB838\uC2B5\uB2C8\uB2E4."
  - "\uADF8\uB7EC\uB098 \uC0AC\uB791\uD558\uB294 \uC544\uB0B4 \uC5D0\uC6B0\uB9AC\uB514\uCF00\uC758
    \uC8FD\uC74C \uC55E\uC5D0\uC11C\u2026 \uADF8 \uC5B4\uB5A4 \uB178\uB798\uB3C4
    \uADF8\uB140\uB97C \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uB098\uB294 \uBAA8\uB4E0 \uC2E0\uC5D0\uAC8C
    \uB178\uB798\uD588\uC2B5\uB2C8\uB2E4. \uC2E0\uB4E4\uC758 \uB9C8\uC74C\uC744 \uC6C0\uC9C1\uC774\uB824
    \uD588\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uD558\uC9C0\uB9CC\u2026 \uADF8 \uC5B4\uB5A4
    \uB300\uB2F5\uB3C4 \uB3CC\uC544\uC624\uC9C0 \uC54A\uC558\uC2B5\uB2C8\uB2E4.\r\n"
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uADF8\uB807\uB2E4\uBA74\u2026 \uB0B4\uAC00
    \uC9C1\uC811 \uADF8\uB140\uB97C \uB370\uB824\uC624\uACA0\uC2B5\uB2C8\uB2E4.\r\n"
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uC124\uB839 \uADF8 \uAE38\uC774 \uC8FD\uC740
    \uC790\uB4E4\uC758 \uB098\uB77C, \uBA85\uACC4\uB77C \uD560\uC9C0\uB77C\uB3C4.\r\n"
  - "\u203B \uBC29\uD5A5\uD0A4\uB85C \uC6C0\uC9C1\uC774\uBA70 \uAE38\uC744 \uCC3E\uACE0,
    \uC74C\uD45C\uB97C \uBAA8\uC544 \uC55E\uC73C\uB85C \uB098\uC544\uAC00\uC138\uC694."
