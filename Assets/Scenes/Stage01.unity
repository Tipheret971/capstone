--- !u!114 &1465020594
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1465020593}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46437f1ce53ac85488354139f2a9b9ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSentences:
  - "(\uACF5\uAE30\uB294 \uBB34\uAC81\uACE0, \uC2DC\uC57C\uB294 \uB4A4\uBC14\uB00C\uC5C8\uB2E4.
    \uBA85\uACC4\uAC00 \uAC00\uAE4C\uC6CC\uC9C0\uB294 \uAC83\uC744 \uC2E4\uAC10\uD55C\uB2E4.)"
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uC544\u2026 \uC774 \uCC28\uAC00\uC6C0\uC740\u2026
    \uB354 \uC774\uC0C1 \uC0B4\uC544\uC788\uB294 \uC790\uC758 \uB545\uC758 \uAE30\uC6B4\uC774
    \uC544\uB2D9\uB2C8\uB2E4. \uC228 \uB9C9\uD788\uB294 \uACE0\uB3C5, \uADF8\uB9AC\uACE0
    \uC601\uC6D0\uD55C \uB9DD\uAC01\uC758 \uBB34\uAC8C."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uBA85\uACC4\uC758 \uC9C0\uBC30\uC790, \uD558\uB370\uC2A4\uC5EC.
    \uB2F9\uC2E0\uC758 \uB545\uC5D0, \uC0B0 \uC790\uC758 \uB178\uB798\uAC00 \uC6B8\uB824
    \uD37C\uC9C8 \uAC83\uC785\uB2C8\uB2E4. \uB2F9\uC2E0\uC774 \uC9C0\uD0A4\uB294
    \uC9C8\uC11C\uB97C \uB2E8 \uD55C \uBC88\uB9CC \uD754\uB4E4\uC5B4 \uB193\uC744
    \uB178\uB798\uAC00!"
