MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1903157891}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46437f1ce53ac85488354139f2a9b9ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSentences:
  - "(\uB3D9\uAD74\uC774 \uD2B8\uC774\uBA70 \uAC80\uC740 \uAC15\uC774 \uD750\uB974\uB294
    \uACF3\uC5D0 \uB3C4\uCC29\uD55C\uB2E4. \uD574\uACE8\uCC98\uB7FC \uB9C8\uB978
    \uB178\uC778, \uBC43\uC0AC\uACF5 \uCE74\uB860\uC774 \uB0A1\uC740 \uBC30\uB97C
    \uC9C0\uD0A4\uACE0 \uC11C \uC788\uB2E4.)"
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uBC43\uC0AC\uACF5\uC774\uC2DC\uC5EC, \uB098\uC758
    \uC774\uB984\uC740 \uC624\uB974\uD398\uC6B0\uC2A4\uC785\uB2C8\uB2E4. \uB098\uB294
    \uC0B0 \uC790\uC774\uC9C0\uB9CC, \uC9C0\uAE08 \uC774\uACF3\uC758 \uBC95\uC744
    \uB530\uB974\uAE30 \uC704\uD574 \uC654\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uB098\uC5D0\uAC8C \uAC15\uC744 \uAC74\uB108\uAC8C
    \uD574 \uC8FC\uC2DC\uC624. \uB098\uB294 \uC8FD\uC740 \uC790\uB4E4\uC758 \uC655,
    \uD558\uB370\uC2A4 \uB2D8\uAED8 \uC62C\uB9B4 \uB178\uB798\uB97C \uAC00\uC9C0\uACE0
    \uC654\uC2B5\uB2C8\uB2E4."
