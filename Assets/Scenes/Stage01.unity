MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 433894484}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 46437f1ce53ac85488354139f2a9b9ba, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueSentences:
  - "(\uC624\uB974\uD398\uC6B0\uC2A4\uAC00 \uAE4A\uC740 \uC0B0 \uC18D, \uC5B4\uB461\uACE0
    \uCD95\uCD95\uD55C \uB3D9\uAD74 \uC785\uAD6C \uC55E\uC5D0 \uC120\uB2E4)"
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uC5D0\uC6B0\uB9AC\uB514\uCF00, \uB098\uC758
    \uC0AC\uB791. \uC0AC\uB78C\uB4E4\uC740 \uB098\uB97C \uB450\uACE0 \uC2E0\uB4E4\uC744
    \uC124\uB4DD\uD558\uB294 \uC790\uB77C\uACE0 \uD588\uC9C0."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uD558\uC9C0\uB9CC, \uB098\uB294 \uB354 \uC774\uC0C1
    \uC2E0\uC758 \uC790\uBE44\uB97C \uAD6C\uAC78\uD558\uC9C0 \uC54A\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uB098\uB294 \uC9C0\uAE08\uBD80\uD130 \uC774
    \uC138\uC0C1 \uBC16\uC758 \uB178\uB798\uB97C \uBD80\uB974\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uC624\uB974\uD398\uC6B0\uC2A4: \uB098\uB294 \uB098\uC758 \uB178\uB798\uB97C
    \uBC14\uCCD0 \uB2F9\uC2E0\uC744 \uB3CC\uB824\uBC1B\uC744 \uAC83\uC785\uB2C8\uB2E4.
    \uAE30\uD544\uCF54."
